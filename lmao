local function isTeammate(player)
	if player == LocalPlayer then return true end

	-- 1. Official Team object
	if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
		return true
	end

	-- 2. TeamColor (very common in FPS games)
	if LocalPlayer.TeamColor and player.TeamColor 
		and LocalPlayer.TeamColor ~= BrickColor.new("White")
		and LocalPlayer.TeamColor == player.TeamColor then
		return true
	end

	-- 3. Neutral check – if both are neutral we treat them as NOT teammates
	--    (so you can still shoot neutrals in FFA)
	return false
end

----------------------------------------------------------------
-- TARGETING
----------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = true

local visCache = setmetatable({}, { __mode = "k" })
local VIS_GRACE = 0.25

local function isVisible(camera, part)
	local filter = { camera }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(filter, p.Character) end
	end
	rayParams.FilterDescendantsInstances = filter

	local origin = camera.CFrame.Position
	local result = workspace:Raycast(origin, part.Position - origin, rayParams)
	local now = os.clock()
	if result == nil then
		visCache[part] = now
		return true
	end
	local seen = visCache[part]
	return seen ~= nil and (now - seen) < VIS_GRACE
end

local lockedPart, lockedAt = nil, 0
local STICK_BONUS = 0.55
local SWITCH_HOLD = 0.35

local function getBestTarget(camera)
	local now = os.clock()
	local best, bestDist = nil, Settings.FovRadius
	local mousePos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
	local camPos = camera.CFrame.Position

	for _, player in ipairs(Players:GetPlayers()) do
		-- FIXED: only skip if TeamCheck is ON and they are a teammate
		if player ~= LocalPlayer and not (Settings.TeamCheck and isTeammate(player)) then
			local char = player.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local head = char and char:FindFirstChild("Head")
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and (head or root) then
				local order = { head, root }
				if lockedPart and lockedPart.Parent == char and (now - lockedAt) < SWITCH_HOLD then
					order = { lockedPart }
				end

				for _, part in ipairs(order) do
					if part and (part.Position - camPos).Magnitude <= Settings.MaxDistance then
						local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
						if onScreen then
							local d = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
							if lockedPart and part.Parent == lockedPart.Parent then
								d *= STICK_BONUS
							end
							if d < bestDist then
								if not Settings.WallCheck or isVisible(camera, part) then
									bestDist = d
									best = part
									break
								end
							else
								break
							end
						end
					end
				end
			end
		end
	end

	if best ~= lockedPart then
		lockedPart, lockedAt = best, now
	end
	return best
end

