local function makeToggle(text, y, key)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 30)
	btn.Position = UDim2.new(0.05, 0, 0, y)
	btn.TextColor3 = Color3.fromRGB(240, 255, 245)
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.Parent = mainFrame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)

	local function refresh(animated)
		local on = Settings[key]
		btn.Text = text .. "  ·  " .. (on and "ON" or "OFF")
		local targetColor = on and ON_COLOR or OFF_COLOR
		if animated then
			TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = targetColor}):Play()
		else
			btn.BackgroundColor3 = targetColor
		end
	end
	refresh(false)

	btn.MouseButton1Click:Connect(function()
		Settings[key] = not Settings[key]
		refresh(true)
	end)
end

local function makeSlider(text, y, key, minV, maxV, step, decimals)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.9, 0, 0, 18)
	label.Position = UDim2.new(0.05, 0, 0, y)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(180, 200, 190)
	label.TextSize = 12
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = mainFrame

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0.9, 0, 0, 8)
	track.Position = UDim2.new(0.05, 0, 0, y + 22)
	track.BackgroundColor3 = Color3.fromRGB(28, 32, 40)
	track.BorderSizePixel = 0
	track.Parent = mainFrame
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = ACCENT
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local function render(animated)
		local v = Settings[key]
		local rel = math.clamp((v - minV) / (maxV - minV), 0, 1)
		label.Text = string.format("%s  ·  %." .. decimals .. "f", text, v)
		if animated then
			TweenService:Create(fill, TWEEN_FAST, {Size = UDim2.new(rel, 0, 1, 0)}):Play()
		else
			fill.Size = UDim2.new(rel, 0, 1, 0)
		end
	end
	render(false)

	local function setFromX(x, animated)
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = minV + rel * (maxV - minV)
		v = math.floor(v / step + 0.5) * step
		Settings[key] = math.clamp(v, minV, maxV)
		render(animated)
	end

	local dragging = false
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X, true)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X, false)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

