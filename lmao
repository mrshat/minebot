RunService:BindToRenderStep("MineBot", Enum.RenderPriority.Last.Value, function(dt)
	local camera = workspace.CurrentCamera
	if not camera then return end

	local cfIn = camera.CFrame
	local inPitch, inYaw = cfIn:ToOrientation()

	if camera ~= lastCamera or camera.CameraSubject ~= lastSubject then
		needResync = true
		lastCamera, lastSubject = camera, camera.CameraSubject
	end

	if needResync then
		aYaw, aPitch = inYaw, inPitch
		prevInYaw, prevInPitch = inYaw, inPitch
		prevOutYaw, prevOutPitch = inYaw, inPitch
		score = 0
		needResync = false
	else
		local retY = wrapAngle(inYaw - prevOutYaw)
		local retP = inPitch - prevOutPitch
		local rebY = wrapAngle(inYaw - prevInYaw)
		local rebP = inPitch - prevInPitch
		local retMag, rebMag = len(retY, retP), len(rebY, rebP)

		if CAMERA_MODE == "auto" then
			local offset = len(wrapAngle(prevOutYaw - prevInYaw), prevOutPitch - prevInPitch)
			if offset > 0.01 then
				score = math.clamp(score + (rebMag - retMag), -1, 1)
			end
			if score > 0.1 then retainsMode = true
			elseif score < -0.1 then retainsMode = false end
		else
			retainsMode = (CAMERA_MODE == "retain")
		end

		CamModeName = retainsMode and "retain" or "rebuild"

		local dY, dP, mag = rebY, rebP, rebMag
		if retainsMode then
			dY, dP, mag = retY, retP, retMag
		end

		if mag > RESYNC_JUMP then
			aYaw, aPitch = inYaw, inPitch
			score = 0
		else
			aYaw += dY
			aPitch = math.clamp(aPitch + dP, -MAX_PITCH, MAX_PITCH)
		end
	end

	if aYaw ~= aYaw or aPitch ~= aPitch then
		aYaw, aPitch = inYaw, inPitch
	end

	setCamera(camera, cfIn)

	local char = LocalPlayer.Character
	local myHumanoid = char and char:FindFirstChildOfClass("Humanoid")
	local alive = myHumanoid ~= nil and myHumanoid.Health > 0

	if alive then
		setBodyYaw(char, aYaw)
	end

	local engaged = alive and Settings.Enabled and (not Settings.MiddleToggle or AimToggled)

	if engaged then
		local target = getBestTarget(camera)
		LastTargetName = target and target.Parent and target.Parent.Name or "none"

		if target then
			local camPos = camera.CFrame.Position
			if (target.Position - camPos).Magnitude > 0.5 then
				local gPitch, gYaw = CFrame.lookAt(camPos, target.Position):ToOrientation()

				local blend = (1 - Settings.Smoothness) * Settings.Strength
				local alpha = 1 - (1 - math.clamp(blend, 0, 1)) ^ (dt * 60)

				local stepY = wrapAngle(gYaw - aYaw) * alpha
				local stepP = (gPitch - aPitch) * alpha

				local maxStep = MAX_PULL_SPEED * dt
				local stepMag = len(stepY, stepP)
				if stepMag > maxStep then
					local scale = maxStep / stepMag
					stepY *= scale
					stepP *= scale
				end

				aYaw += stepY
				aPitch = math.clamp(aPitch + stepP, -MAX_PITCH, MAX_PITCH)

				setCamera(camera, cfIn)
				setBodyYaw(char, aYaw)
			end
		end
	end

	prevInYaw, prevInPitch = inYaw, inPitch
	prevOutYaw, prevOutPitch = aYaw, aPitch
end)-- WalkSpeed Spoof Script (Speed 200)
