local CAMERA_MODE = "rebuild"

local MAX_PITCH      = math.rad(80)
local MAX_PULL_SPEED = math.rad(720)
local RESYNC_JUMP    = 1.2

local aYaw, aPitch = 0, 0
local prevInYaw, prevInPitch = 0, 0
local prevOutYaw, prevOutPitch = 0, 0
local score = 0
local retainsMode = false
local needResync = true
local lastCamera, lastSubject = nil, nil

local function wrapAngle(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function len(y, p)
	return math.sqrt(y * y + p * p)
end

local function setCamera(camera, cfIn)
	camera.CFrame = CFrame.new(cfIn.Position) * CFrame.fromOrientation(aPitch, aYaw, 0)
end

local function setBodyYaw(char, yaw)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not root then return end
	if humanoid then humanoid.AutoRotate = false end

	local pos = root.Position
	local velocity = root.AssemblyLinearVelocity
	root.CFrame = CFrame.new(pos) * CFrame.fromOrientation(0, yaw, 0)
	root.AssemblyLinearVelocity = velocity
end

LocalPlayer.CharacterAdded:Connect(function(char)
