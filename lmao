local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer
local trackingVisible = true

-- Helper function to establish the information layout on a character model locally
local function createTracker(character, targetPlayer)
	if targetPlayer == localPlayer then return end
	
	-- Wait for critical torso elements to stream into the client scene
	local head = character:WaitForChild("Head", 5)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	
	if not head or not root then return end
	if head:FindFirstChild("TrackingLabel") then return end -- Prevent duplicates

	-- 1. Create a 2D interface panel linked directly to the target head coordinate
	local billboardGui = Instance.new("BillboardGui")
	billboardGui.Name = "TrackingLabel"
	billboardGui.Size = UDim2.new(0, 200, 0, 50)
	billboardGui.StudsOffset = Vector3.new(0, 3, 0) 
	billboardGui.AlwaysOnTop = true 
	billboardGui.Enabled = trackingVisible -- Match current global visibility filter state
	billboardGui.Parent = head
	
	-- 2. Text styling config
	local infoLabel = Instance.new("TextLabel")
	infoLabel.Size = UDim2.new(1, 0, 1, 0)
	infoLabel.BackgroundTransparency = 1
	infoLabel.TextSize = 14
	infoLabel.Font = Enum.Font.SourceSansBold
	infoLabel.TextColor3 = Color3.fromRGB(255, 0, 0) 
	infoLabel.TextStrokeTransparency = 0 
	infoLabel.Parent = billboardGui
	
	-- 3. Dynamic distance tracker runner loop
	task.spawn(function()
		while character:IsDescendantOf(workspace) and root:IsDescendantOf(workspace) and head:IsDescendantOf(workspace) do
			if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local localRoot = localPlayer.Character.HumanoidRootPart
				-- Calculate current real-time magnitude distance vector
				local distance = math.floor((root.Position - localRoot.Position).Magnitude)
				infoLabel.Text = string.format("%s\n[%d studs]", targetPlayer.Name, distance)
			else
				infoLabel.Text = targetPlayer.Name
			end
			task.wait(0.1) -- Fast updates without rendering lag
		end
	end)
end

-- Safely process a player profile sequence on the client
local function handlePlayer(player)
	if player.Character then
		task.spawn(createTracker, player.Character, player)
	end
	player.CharacterAdded:Connect(function(character)
		createTracker(character, player)
	end)
end

-- Initialize loop for players already present in the runtime layout instance
for _, player in ipairs(Players:GetPlayers()) do
	handlePlayer(player)
end
Players.PlayerAdded:Connect(handlePlayer)

